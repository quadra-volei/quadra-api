{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Jwt": {
      "Issuer": "quadra-api",
      "Audience": "quadra-mobile",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "ClockSkewSeconds": 30
    },
    "PhoneVerification": {
      "Provider": "Twilio",
      "Twilio": {
        "AccountSid": "",
        "AuthToken": "",
        "VerifyServiceSid": ""
      }
    },
    "Google": {
      "ClientId": "",
      "Issuer": "https://accounts.google.com",
      "JwksUri": "https://accounts.google.com/.well-known/openid-configuration"
    },
    "Apple": {
      "ClientId": "",
      "Issuer": "https://appleid.apple.com",
      "JwksUri": "https://appleid.apple.com/.well-known/openid-configuration"
    }
  },
  "Places": {
    "Provider": "",
    "GoogleApiKey": ""
  },
  "Aws": {
    "Sqs": {
      "UserRegisteredQueueUrl": "",
      "UserLoggedInQueueUrl": ""
    },
    "S3": {
      "ProfilePhotosBucket": "",
      "PhotoUploadUrlTtlMinutes": 15,
      "PhotoReadUrlTtlMinutes": 60
    }
  }
}
